// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum Rol {
  PACIENTE
  MEDICO
  ADMIN
}

enum EstadoCita {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
}

model Consultorio {
  id           Int       @id @default(autoincrement())
  nombre       String
  especialidad String
  direccion    String
  telefono     String
  email        String?
  descripcion  String?
  creadoEn     DateTime  @default(now())
  duracionCita Int       @default(30)
  horarios     Horario[]

  medicos      Usuario[]
  citas        Cita[]
}

model Usuario {
  id            Int          @id @default(autoincrement())
  nombre        String
  email         String       @unique
  password      String
  telefono      String?
  rol           Rol          @default(PACIENTE)
  creadoEn      DateTime     @default(now())

  consultorioId Int?
  consultorio   Consultorio? @relation(fields: [consultorioId], references: [id])
  citas         Cita[]
}

model Cita {
  id            Int         @id @default(autoincrement())
  fecha         DateTime
  motivo        String?
  estado        EstadoCita  @default(PENDIENTE)
  creadoEn      DateTime    @default(now())

  pacienteId    Int
  paciente      Usuario     @relation(fields: [pacienteId], references: [id])
  consultorioId Int
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id])
}

model Horario {
  id            Int         @id @default(autoincrement())
  diaSemana     Int         // 0 = domingo, 1 = lunes ... 6 = sábado
  horaInicio    String      // "08:00"
  horaFin       String      // "12:00"

  consultorioId Int
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id], onDelete: Cascade)
}